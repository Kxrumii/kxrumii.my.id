<header class="site-header" data-route-shell="header">
  <div class="brand-group">
    <a
      class="brand-name"
      href="/"
      data-page-transition="home"
      aria-label="KXRUMII — halaman utama"
    >
      <span class="route-reveal-mask" style="--route-group:0">
        <span class="route-reveal-line">KXRUMII</span>
      </span>
    </a>
    <button
      class="role-button"
      type="button"
      aria-haspopup="dialog"
      aria-controls="about-panel"
      aria-expanded="false"
      id="about-trigger"
      aria-label="Tentang arsip PAW"
    >
      <span class="role-mask" aria-hidden="true">
        <span class="role-line role-line--archive" id="role-archive" data-id="PAW ARCHIVE" data-en="PAW ARCHIVE">PAW ARCHIVE</span>
        <span class="role-line role-line--about" id="role-about" data-id="TENTANG" data-en="ABOUT">TENTANG</span>
      </span>
    </button>
  </div>

</header>
