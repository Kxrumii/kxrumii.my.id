---
/*
 * Bootstrap transisi bersama (sumber tunggal: @kxrumii/transition-bridge).
 * Harus jadi elemen pertama setelah <meta charset> supaya jalan sebelum stylesheet
 * apa pun. Teks yang sama di-inject ke empat app Vite lewat
 * scripts/vite-transition-bootstrap.mjs dan dicek di CI.
 */
import bootstrap from '@kxrumii/transition-bridge/bootstrap.inline.js?raw';

const code = bootstrap.trim();
---
<script is:inline data-transition-bootstrap="v4" set:html={`\n${code}\n`} />
