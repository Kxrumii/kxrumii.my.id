---
import '@kxrumii/transition-bridge/transition-bridge.css';
import '../styles/global.css';
import '../styles/page-transitions.css';
import { ClientRouter } from 'astro:transitions';
import TransitionBootstrap from '../components/TransitionBootstrap.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="id" class="home-document" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <TransitionBootstrap />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20100%20100%27%3E%3Ctext%20x%3D%2750%27%20y%3D%2750%27%20text-anchor%3D%27middle%27%20dominant-baseline%3D%27central%27%20font-size%3D%2780%27%20font-family%3D%27monospace%27%20font-weight%3D%27bold%27%20fill%3D%27%2340a02b%27%3EF%3C/text%3E%3C/svg%3E"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0b" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    transition:animate="none"
    data-page="home"
    class="bg-transparent text-[#f5f5f5] h-dvh overflow-hidden flex flex-col justify-between p-6 md:p-12 antialiased selection:bg-emerald-500 selection:text-black"
  >
    <slot />
    <script>
      import '../scripts/page-transitions';
      import '../scripts/transition-bridge';
    </script>
  </body>
</html>
