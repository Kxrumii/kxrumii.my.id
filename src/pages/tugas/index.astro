---
import '../../styles/global.css';

const tasks = [
  {
    meeting: '01',
    title: 'Profil Diri dengan HTML5',
    description: 'Halaman profil menggunakan HTML5 semantik, metadata, biodata, foto, dan tabel mata kuliah.',
    href: '/tugas/pertemuan-1/',
    technology: 'HTML5',
    status: 'Fondasi tersedia',
  },
  {
    meeting: '06',
    title: 'Task Manager',
    description: 'Aplikasi daftar tugas kuliah menggunakan TypeScript dan Vite.',
    href: '/tugas/pertemuan-6/',
    technology: 'TypeScript · Vite',
    status: 'Kerangka aplikasi',
  },
  {
    meeting: '07',
    title: 'Component-Based UI',
    description: 'Aplikasi React dengan komponen reusable, props, state, dan interaksi.',
    href: '/tugas/pertemuan-7/',
    technology: 'React · Vite',
    status: 'Kerangka aplikasi',
  },
  {
    meeting: '08',
    title: 'Application Architecture',
    description: 'Aplikasi multi-halaman dengan React Router, state management, dan public API.',
    href: '/tugas/pertemuan-8/',
    technology: 'React · React Router · Vite',
    status: 'Kerangka aplikasi',
  },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Daftar tugas Pengembangan Aplikasi Web pada website pribadi Fahri." />
    <title>Arsip Tugas | Fahrii</title>
  </head>
  <body class="min-h-screen bg-[#0a0a0a] text-[#f5f5f5] antialiased selection:bg-emerald-500 selection:text-black">
    <main class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-6 py-8 md:px-12 md:py-12">
      <header class="flex items-center justify-between border-b border-white/10 pb-6">
        <a href="/" class="font-mono text-sm text-gray-300 transition-colors hover:text-emerald-400">← kxrumii.my.id</a>
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-gray-600">PAW / ARCHIVE</span>
      </header>

      <section class="py-16 md:py-24">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-emerald-400">Pengembangan Aplikasi Web</p>
        <h1 class="max-w-4xl text-5xl font-semibold tracking-[-0.06em] md:text-7xl">Tugas & eksperimen.</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-gray-400 md:text-lg">
          Kumpulan tugas perkuliahan dan ruang eksperimen teknologi web. Setiap aplikasi
          dikembangkan secara terpisah sesuai kebutuhan teknologi pada pertemuannya.
        </p>
      </section>

      <section class="grid gap-3" aria-label="Daftar tugas PAW">
        {tasks.map((task) => (
          <a href={task.href} class="group grid gap-4 rounded-xl border border-white/10 bg-white/[0.025] p-5 transition-colors hover:border-emerald-400/40 hover:bg-white/[0.045] md:grid-cols-[72px_1fr_auto] md:items-center md:p-7">
            <span class="font-mono text-sm text-gray-600">{task.meeting}</span>
            <span class="block">
              <span class="block text-xl font-medium tracking-tight text-gray-100 transition-colors group-hover:text-emerald-300 md:text-2xl">{task.title}</span>
              <span class="mt-2 block max-w-2xl text-sm leading-6 text-gray-500">{task.description}</span>
              <span class="mt-3 block font-mono text-[10px] uppercase tracking-wider text-gray-600">{task.technology}</span>
            </span>
            <span class="flex items-center gap-3 text-xs text-gray-500 md:text-right">
              <span>{task.status}</span>
              <span class="text-lg transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
            </span>
          </a>
        ))}
      </section>

      <footer class="mt-auto pt-16 font-mono text-[10px] uppercase tracking-wider text-gray-700">© {new Date().getFullYear()} / Fahri Khairun Ariansyah</footer>
    </main>
  </body>
</html>
