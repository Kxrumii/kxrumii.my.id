---
import { ClientRouter } from 'astro:transitions';
import PortalHeader from '../../components/portal/PortalHeader.astro';
import ProjectList from '../../components/portal/ProjectList.astro';
import PortalFooter from '../../components/portal/PortalFooter.astro';
import AboutPanel from '../../components/portal/AboutPanel.astro';
import TransitionBootstrap from '../../components/TransitionBootstrap.astro';
import '@kxrumii/transition-bridge/transition-bridge.css';
import '../../styles/portal.css';
import '../../styles/page-transitions.css';

---
<!doctype html>
<html lang="id" class="portal-document" data-mood="dark" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <TransitionBootstrap />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0b" />
    <meta
      name="description"
      content="Arsip tugas dan eksperimen mata kuliah Pengembangan Aplikasi Web."
    />
    <title>KXRUMII — Arsip PAW</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const moods = ['light', 'dark', 'red', 'yellow'];
        try {
          const savedMood = localStorage.getItem('kxrumii-portal-mood-v2');
          const savedLanguage = localStorage.getItem('kxrumii-portal-language');
          if (moods.includes(savedMood)) root.dataset.mood = savedMood;
          if (savedLanguage === 'id' || savedLanguage === 'en') root.lang = savedLanguage;
        } catch {
          // Dark / Indonesian defaults remain available without browser storage.
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body transition:animate="none" data-page="portal">
    <a
      class="skip-link"
      href="#archive"
      data-id="Langsung ke daftar tugas"
      data-en="Skip to project list"
    >Langsung ke daftar tugas</a>

    <PortalHeader />
    <ProjectList />
    <PortalFooter />
    <AboutPanel />

    <script>
      import '../../scripts/portal';
      import '../../scripts/page-transitions';
      import '../../scripts/transition-bridge';
    </script>
  </body>
</html>
