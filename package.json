{
  "name": "kxrumii.my.id",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "npm@12.2.3",
  "workspaces": [
    "packages/transition-bridge",
    "apps/pertemuan-1",
    "apps/pertemuan-6",
    "apps/pertemuan-7",
    "apps/pertemuan-8",
    "apps/pertemuan-9"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:t1": "npm run dev --workspace=@kxrumii/pertemuan-1",
    "dev:t6": "npm run dev --workspace=@kxrumii/pertemuan-6",
    "dev:t7": "npm run dev --workspace=@kxrumii/pertemuan-7",
    "dev:t8": "npm run dev --workspace=@kxrumii/pertemuan-8",
    "dev:t9": "npm run dev --workspace=@kxrumii/pertemuan-9",
    "clean:generated": "node scripts/clean-generated.mjs",
    "check": "npm run check --workspaces --if-present",
    "build:apps": "npm run build --workspaces --if-present",
    "build": "npm run clean:generated && npm run build:apps && astro build",
    "preview": "astro preview",
    "verify:transition": "node scripts/verify-transition-bootstrap.mjs",
    "favicons": "node scripts/build-favicons.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@kxrumii/transition-bridge": "0.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
